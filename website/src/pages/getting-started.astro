---
import '../styles/global.css'

const BASE = import.meta.env.BASE_URL
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Building on Vega</title>
  <meta name="description" content="From brew install to your first API call in 60 seconds. Build a frontend, integration, or product on top of Vega's HTTP + SSE API." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#9733;</text></svg>" />
</head>

<body class="antialiased">

  <!-- Nav -->
  <header class="sticky top-0 z-50 border-b border-zinc-800/50 bg-[#09090b]/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href={BASE} class="flex items-center gap-2.5">
        <span class="text-amber-400 text-lg">&#9733;</span>
        <span class="font-mono font-semibold text-sm gradient-text">Vega</span>
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm text-zinc-400">
        <a href={BASE} class="hover:text-white transition-colors">Home</a>
        <span class="text-white">Building on Vega</span>
      </nav>
    </div>
  </header>

  <!-- Header -->
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-12 text-center">
    <p class="section-label">Guide</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
      Building <span class="gradient-text">on Vega</span>
    </h1>
    <p class="text-lg text-zinc-400 max-w-xl mx-auto">
      From <code class="text-base bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5 text-zinc-300">brew install</code> to your first API call in about 60 seconds.
    </p>
  </section>

  <!-- Quick start -->
  <section id="quick-start" class="max-w-3xl mx-auto px-6 pb-12">
    <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-6">
      <p class="text-sm text-amber-400 font-medium mb-2">Step 0 &middot; Install &amp; run</p>
      <p class="text-sm text-zinc-300 leading-relaxed mb-4">
        Install the binary, run <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">vega serve</code>, and you've got a Vega runtime listening on <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">localhost:8080</code> with the dashboard, REST API, and SSE event stream — no auth wiring required.
      </p>
      <div class="code-block mb-4">
        <p><span class="syn-comment">$</span> <span class="syn-str">brew install</span> everydev1618/tap/vega</p>
        <p class="mt-1"><span class="syn-comment">$</span> <span class="syn-str">vega serve</span></p>
        <p class="text-zinc-500 mt-1">&#x25B6; Dashboard ready at http://localhost:8080</p>
      </div>
      <p class="text-xs text-zinc-500 leading-relaxed">
        Talk to <span class="text-violet-400 font-mono">Iris</span> in the dashboard &mdash; she's your chief of staff. Tell her what you need; <span class="text-amber-400 font-mono">Hera</span> builds agents on the fly.
      </p>
    </div>
  </section>

  <!-- Prerequisites -->
  <section class="max-w-3xl mx-auto px-6 pb-12">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5">
      <p class="text-sm text-zinc-300 font-medium mb-2">Prerequisites for the rest of this guide</p>
      <ul class="text-sm text-zinc-400 space-y-1">
        <li>An <a href="https://console.anthropic.com/" target="_blank" class="text-indigo-400 hover:text-indigo-300 transition-colors">Anthropic API key</a> &middot; <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">export ANTHROPIC_API_KEY=sk-ant-...</code> before <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">vega serve</code></li>
        <li><code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">vega serve</code> running on <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">localhost:8080</code> (from Step 0)</li>
      </ul>
    </div>
  </section>

  <!-- Step 1 -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <div class="flex items-center gap-4 mb-5">
      <span class="flex-none w-8 h-8 rounded-full bg-indigo-600 text-white font-mono text-sm flex items-center justify-center font-semibold">1</span>
      <h2 class="text-xl font-semibold text-white">Make your first API call</h2>
    </div>

    <div class="code-block text-sm leading-relaxed mb-5">
      <p><span class="syn-key">const</span> <span class="syn-type">res</span> = <span class="syn-key">await</span> <span class="syn-fn">fetch</span>(<span class="syn-str">'http://localhost:8080/api/v1/identity'</span>)</p>
      <p><span class="syn-key">const</span> <span class="syn-type">identity</span> = <span class="syn-key">await</span> <span class="syn-type">res</span>.<span class="syn-fn">json</span>()</p>
      <p class="text-zinc-500 mt-1"><span class="syn-comment">// &#123; orchestrator: ..., builder: ..., product_name: ... &#125;</span></p>
    </div>

    <p class="text-sm text-zinc-400 mb-4">Other endpoints worth poking at first:</p>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 text-sm overflow-x-auto">
      <table class="w-full text-zinc-400">
        <tbody class="divide-y divide-zinc-800">
          <tr>
            <td class="py-2 pr-4 font-mono text-xs text-zinc-300 whitespace-nowrap">GET /api/v1/identity</td>
            <td class="py-2">Orchestrator + builder display names</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-xs text-zinc-300 whitespace-nowrap">GET /api/v1/agents</td>
            <td class="py-2">All agents in this runtime</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-xs text-zinc-300 whitespace-nowrap">GET /api/v1/processes</td>
            <td class="py-2">Running + recent processes</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-xs text-zinc-300 whitespace-nowrap">GET /api/v1/channels</td>
            <td class="py-2">Channels (group conversations)</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-xs text-zinc-300 whitespace-nowrap">GET /api/v1/inbox</td>
            <td class="py-2">Inbox items waiting for review</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-xs text-zinc-300 whitespace-nowrap">POST /api/v1/agents/&lcub;name&rcub;/chat</td>
            <td class="py-2">DM an agent &mdash; returns the response</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Step 2 -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <div class="flex items-center gap-4 mb-5">
      <span class="flex-none w-8 h-8 rounded-full bg-indigo-600 text-white font-mono text-sm flex items-center justify-center font-semibold">2</span>
      <h2 class="text-xl font-semibold text-white">Subscribe to live events</h2>
    </div>
    <p class="text-sm text-zinc-400 mb-4 leading-relaxed">
      <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5 text-zinc-300">EventSource</code> opens a persistent stream &mdash; agents push activity in real time.
    </p>
    <div class="code-block text-sm leading-relaxed mb-5">
      <p><span class="syn-key">const</span> <span class="syn-type">es</span> = <span class="syn-key">new</span> <span class="syn-fn">EventSource</span>(<span class="syn-str">'http://localhost:8080/api/v1/events'</span>)</p>
      <p class="mt-2"><span class="syn-type">es</span>.<span class="syn-fn">addEventListener</span>(<span class="syn-str">'process.completed'</span>, (e) =&gt; &#123;</p>
      <p class="pl-4"><span class="syn-key">const</span> ev = <span class="syn-type">JSON</span>.<span class="syn-fn">parse</span>(e.data)</p>
      <p class="pl-4"><span class="syn-comment">// dispatch to your store / queries</span></p>
      <p>&#125;)</p>
    </div>
    <p class="text-sm text-zinc-400 mb-2">Event types:</p>
    <p class="text-xs text-zinc-500 font-mono leading-relaxed">
      process.started &middot; process.completed &middot; process.failed<br/>
      workflow.completed &middot; workflow.failed<br/>
      agent.created &middot; agent.deleted<br/>
      chat.update &middot; chat.event<br/>
      channel.message &middot; channel.thread_reply
    </p>
    <p class="text-xs text-zinc-500 mt-4 leading-relaxed">
      Per-agent live progress (token deltas, tool calls) lives on a separate stream:
      <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5 text-zinc-300">GET/POST /api/v1/agents/&lcub;name&rcub;/chat/stream</code>.
      Channels have an analogous pair.
    </p>
  </section>

  <!-- Step 3 -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <div class="flex items-center gap-4 mb-5">
      <span class="flex-none w-8 h-8 rounded-full bg-indigo-600 text-white font-mono text-sm flex items-center justify-center font-semibold">3</span>
      <h2 class="text-xl font-semibold text-white">Type-safe with @vega/api-types</h2>
    </div>
    <p class="text-sm text-zinc-400 mb-4 leading-relaxed">
      Generated from the OpenAPI spec. Pair with <a href="https://openapi-ts.dev/openapi-fetch/" target="_blank" class="text-indigo-400 hover:text-indigo-300 transition-colors">openapi-fetch</a> for fully type-inferred client calls:
    </p>
    <div class="code-block text-sm leading-relaxed">
      <p><span class="syn-key">import</span> <span class="syn-fn">createClient</span> <span class="syn-key">from</span> <span class="syn-str">'openapi-fetch'</span></p>
      <p><span class="syn-key">import type</span> &#123; paths &#125; <span class="syn-key">from</span> <span class="syn-str">'@vega/api-types'</span></p>
      <p class="mt-2"><span class="syn-key">const</span> <span class="syn-type">client</span> = <span class="syn-fn">createClient</span>&lt;paths&gt;(&#123;</p>
      <p class="pl-4">baseUrl: <span class="syn-str">'http://localhost:8080'</span>,</p>
      <p>&#125;)</p>
      <p class="mt-2"><span class="syn-key">const</span> &#123; data, error &#125; = <span class="syn-key">await</span> <span class="syn-type">client</span>.<span class="syn-fn">GET</span>(<span class="syn-str">'/api/v1/identity'</span>)</p>
      <p class="text-zinc-500 mt-1"><span class="syn-comment">// data is fully typed; error too</span></p>
    </div>
    <p class="text-xs text-zinc-500 mt-3 leading-relaxed">
      Until <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5 text-zinc-300">@vega/api-types</code> is published to npm, vendor or path-import.
    </p>
  </section>

  <!-- Production -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5">
      <p class="text-sm text-zinc-300 font-medium mb-2">Going to production</p>
      <p class="text-sm text-zinc-400 leading-relaxed">
        For multi-user or multi-tenant deployments, layer JWT auth on top of <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">vega serve</code>. govega ships a <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">cmd/control-plane</code> that issues RS256 tokens (JWKS endpoint included). Your runtime validates them locally; clients send <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">Authorization: Bearer &lt;token&gt;</code> on fetch and <code class="text-xs bg-zinc-900 border border-zinc-800 rounded px-1.5 py-0.5">?access_token=&lt;token&gt;</code> on SSE. Production-grade login plugs into WorkOS or your IdP of choice.
      </p>
    </div>
  </section>

  <!-- What's next -->
  <section class="max-w-3xl mx-auto px-6 pb-24">
    <h2 class="text-xl font-semibold text-white mb-6">What's next</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href={`${BASE}#features`} class="feature-card group block">
        <h3 class="font-semibold text-white mb-1 group-hover:text-indigo-300 transition-colors">Features</h3>
        <p class="text-sm text-zinc-400">Supervision, integrations, teams, streaming</p>
      </a>
      <a href={`${BASE}#how-it-works`} class="feature-card group block">
        <h3 class="font-semibold text-white mb-1 group-hover:text-indigo-300 transition-colors">How it works</h3>
        <p class="text-sm text-zinc-400">Iris, Hera, and the supervision model in four steps</p>
      </a>
      <a href={`${BASE}#build`} class="feature-card group block">
        <h3 class="font-semibold text-white mb-1 group-hover:text-indigo-300 transition-colors">Build on Vega</h3>
        <p class="text-sm text-zinc-400">REST, SSE, and type-safe client snippets at a glance</p>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-zinc-800/50 py-8">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-zinc-500">
      <div class="flex items-center gap-2 font-mono">
        <span class="text-amber-400">&#9733;</span>
        <span class="gradient-text font-semibold">Vega</span>
      </div>
      <nav class="flex items-center gap-6">
        <a href={BASE} class="hover:text-white transition-colors">Home</a>
        <a href={`${BASE}#build`} class="hover:text-white transition-colors">Build</a>
        <a href={`${BASE}#features`} class="hover:text-white transition-colors">Features</a>
      </nav>
    </div>
  </footer>

</body>
</html>
